<resources>
    <!-- Thème minimal : Compose gère le style, on veut juste éviter la
         ActionBar native et un flash blanc au lancement. -->
    <style name="Theme.DistractionBlocker" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
